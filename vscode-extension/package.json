{
  "name": "keypup-mcp",
  "displayName": "Keypup Engineering Analytics",
  "description": "Ask your Keypup engineering data in plain language to track delivery, quality and team workload — directly from VS Code.",
  "version": "1.0.0",
  "publisher": "Keypup",
  "license": "MIT",
  "icon": "assets/keypup-logo.png",
  "homepage": "https://www.keypup.io/mcp-server",
  "author": {
    "name": "Keypup",
    "url": "https://www.keypup.io"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/keypup-io/engineering-analytics-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/keypup-io/engineering-analytics-mcp-server/issues"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "AI",
    "Data Science",
    "Other"
  ],
  "keywords": [
    "mcp",
    "engineering-analytics",
    "developer-productivity",
    "github-analytics",
    "devops",
    "dora",
    "metrics",
    "reporting"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "keypup.engineering-analytics",
        "label": "Keypup Engineering Analytics"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.101.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.6.0"
  }
}